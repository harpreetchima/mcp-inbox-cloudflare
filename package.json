{
  "name": "agents-mail-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typegen": "wrangler types --env-file .dev.vars.example",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run dry-run",
    "dry-run": "wrangler deploy --dry-run --outdir dist",
    "startup-check": "wrangler check startup --outfile dist/worker-startup.cpuprofile",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "postal-mime": "2.7.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
